# ==============================================================================
# RadShift_K34 환경변수 설정 파일 (.env)
# ==============================================================================
# [설정 방법]
# 1. Supabase(https://supabase.com)에 로그인하여 프로젝트 생성 (지역: Seoul)
# 2. 좌측 메뉴 [Project Settings] -> [API] 이동
# 3. Project URL 및 Project API Keys (anon, public) 복사하여 아래에 입력
# 4. 이 파일명을 .env 로 저장하고 start.bat 재실행
# ==============================================================================

# Supabase 프로젝트 URL (예: https://abcdefghijklm.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon/Public Key (공개 클라이언트 키)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# (선택 사항) 텔레그램 봇 토큰 (단톡방 알림용, Supabase Secrets에도 등록 필요)
# VITE_TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
